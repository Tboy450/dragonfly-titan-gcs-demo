# Local-only copies that duplicate files already in the repository.
# Kenney's archive: its contents are extracted in the same folder (kenney/).
research/fantasy-city-2026-10-16/kenney_fantasy-town-kit_2.0.zip
# The three.js npm package: the renderer and the addons in use are in dist/vendor/three/.
research/fantasy-city-2026-10-16/three-0.180.0.tgz

# Portable conversion runtimes and dependency wheels are kept locally, outside deployable source.
research/fantasy-city-2026-10-16/tools/
research/fantasy-city-2026-10-16/converted-sources/**/*.blend
research/fantasy-city-2026-10-16/converted-sources/**/*.log
# Editable Blender authoring projects, logs, regenerable input and local draft binaries.
research/fantasy-city-2026-10-16/foundation-authoring/**/*.blend
research/fantasy-city-2026-10-16/foundation-authoring/**/*.blend1
research/fantasy-city-2026-10-16/foundation-authoring/**/*.log
research/fantasy-city-2026-10-16/foundation-authoring/coast-input.json
research/fantasy-city-2026-10-16/foundation-authoring/contacts.json
research/fantasy-city-2026-10-16/foundation-authoring/drafts/**/*.glb
# Local editable Houdini scene, caches and retained intermediate exports.
research/fantasy-city-2026-10-16/houdini-authoring/**/*.hipnc
research/fantasy-city-2026-10-16/houdini-authoring/**/*.bgeo.sc
research/fantasy-city-2026-10-16/houdini-authoring/**/*.obj
research/fantasy-city-2026-10-16/houdini-authoring/**/*.bak
research/fantasy-city-2026-10-16/houdini-authoring/backup/
research/fantasy-city-2026-10-16/houdini-authoring/drafts/**/*.glb

